FROM golang:1.26-alpine AS build
WORKDIR /src
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/license-center ./cmd/license-center

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && addgroup -S -g 65532 nonroot \
    && adduser -S -D -H -u 65532 -G nonroot nonroot \
    && mkdir -p /data \
    && chown 65532:65532 /data
COPY --from=build --chown=65532:65532 /out/license-center /license-center
EXPOSE 8090
USER 65532:65532
HEALTHCHECK --interval=20s --timeout=3s --start-period=5s --retries=3 CMD ["wget","-qO-","http://127.0.0.1:8090/healthz"]
ENTRYPOINT ["/license-center"]
