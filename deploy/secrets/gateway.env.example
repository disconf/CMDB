DATABASE_URL=postgres://ops_platform_app:CHANGE_ME@DATABASE_HOST:5432/ops_platform?sslmode=disable
REDIS_URL=redis://:CHANGE_ME@REDIS_HOST:6379/0
KAFKA_BROKERS=KAFKA_HOST:9092
# Leave empty for the safe local simulator. Set both values only after the Runner service is ready.
# The token also authenticates Runner -> Gateway internal CMDB asset lookup.
# Set the Runner CMDB_INTERNAL_TOKEN to the same value.
ANSIBLE_RUNNER_URL=
ANSIBLE_RUNNER_TOKEN=CHANGE_ME
PROMETHEUS_URL=http://PROMETHEUS_HOST:9090
ALERTMANAGER_URL=http://ALERTMANAGER_HOST:9093
WEBHOOK_ALLOWED_HOSTS=hooks.example.com
KEYCLOAK_BASE_URL=http://KEYCLOAK_HOST:8081
KEYCLOAK_REALM=cmdb
KEYCLOAK_CLIENT_ID=cmdb-gateway
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ISSUER_URL=http://KEYCLOAK_HOST:8081/realms/cmdb
SESSION_SECRET=CHANGE_ME
AGENT_SHARED_TOKEN=CHANGE_TO_THE_SAME_RANDOM_TOKEN_USED_BY_AGENTS
AGENT_OFFLINE_AFTER=3m
CMDB_NODE_EXPORTER_PORT=9100
# Remote terminal HA bus. Use a dedicated URL to avoid changing the single-node auth cache client.
REMOTE_TERMINAL_REDIS_URL=redis://:CHANGE_ME@REDIS_CLUSTER_SERVICE:6379/0
REDIS_CLUSTER_MODE=true
REDIS_CLUSTER_ADDRS=REDIS_NODE_1:6379,REDIS_NODE_2:6379,REDIS_NODE_3:6379
REMOTE_TERMINAL_BUS=enabled
REMOTE_SESSION_LEASE_TTL=45s
# CI/CD integration center. Leave GitLab empty until its API token is available.
CICD_INSECURE_SKIP_VERIFY=true
CICD_HARBOR_URL=https://harbor.example.com
CICD_HARBOR_USERNAME=admin
CICD_HARBOR_PASSWORD=CHANGE_ME
CICD_ARGOCD_URL=http://argocd-server.ops-qa.svc.cluster.local
CICD_ARGOCD_USERNAME=admin
CICD_ARGOCD_PASSWORD=CHANGE_ME
CICD_GITLAB_URL=
CICD_GITLAB_TOKEN=
# Dedicated token for CI/CD health events. Falls back to RELEASE_WEBHOOK_TOKEN when empty.
CICD_HEALTH_WEBHOOK_TOKEN=
