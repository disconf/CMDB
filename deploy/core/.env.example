# Copy this file to .env on the server. Never commit the real .env file.
COMPOSE_PROJECT_NAME=cmdb-core
BIND_ADDRESS=0.0.0.0
SERVER_HOST=127.0.0.1

# PostgreSQL bootstrap administrator. Use long, unique random passwords.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_POSTGRES_ADMIN
POSTGRES_ADMIN_DB=postgres
PLATFORM_DB_NAME=ops_platform
PLATFORM_DB_USER=ops_platform_app
PLATFORM_DB_PASSWORD=CHANGE_ME_PLATFORM_DB
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS

# Kafka single-node development/acceptance environment
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# Keycloak bootstrap administrator (remove these after creating a permanent admin).
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=kc_bootstrap_admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN
KEYCLOAK_HOSTNAME=http://127.0.0.1:8081

# PostgreSQL must use a local Linux filesystem (ext4/XFS), not NFS/CIFS/FUSE.
POSTGRES_DATA_DIR=/opt/cmdb/data/postgres
