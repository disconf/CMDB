RUNNER_API_TOKEN=CHANGE_TO_A_RANDOM_TOKEN_AT_LEAST_16_CHARS
CMDB_BASE_URL=http://gateway-bff:8080
CMDB_TOKEN=KEYCLOAK_SERVICE_ACCOUNT_ACCESS_TOKEN
RUNNER_COMMAND_MAP_JSON={"health-check --full":"health-check.yml","install-node-exporter":"install-node-exporter.yml"}
MAX_TARGETS=100
SSH_USER=ansible
SSH_PRIVATE_KEY_FILE=/opt/cmdb/secrets/runner_id_ed25519
KNOWN_HOSTS_FILE=/opt/cmdb/secrets/runner_known_hosts
# Optional Ansible Vault password file mounted into the container.
VAULT_PASSWORD_FILE=
# Optional MinIO/S3 artifact archive. Leave endpoint empty to disable.
S3_ENDPOINT_URL=http://192.168.85.134:9000
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET=cmdb-job-artifacts
S3_REGION=us-east-1
